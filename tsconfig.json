{
    "compilerOptions":  {
                            "module":  "commonjs",
                            "target":  "es6",
                            "outDir":  "out",
                            "sourceMap":  true,
                            "rootDir":  ".",
                            "lib":  [
                                        "es6",
                                        "dom"
                                    ],
                            "strictNullChecks":  true,
                            "noImplicitAny":  true,
                            "noUnusedLocals":  true,
                            "noUnusedParameters":  true
                        },
    "exclude":  [
                    "node_modules",
                    ".vscode-test"
                ]
}
